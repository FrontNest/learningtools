# Local environment variables — never commit real secrets here.
NODE_ENV=development
PORT=4000

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Database (SQLite file path, relative to backend/)
DATABASE_URL="file:./data/dev.db"

# Uploads
UPLOAD_DIR=./data/uploads
MAX_ATTACHMENT_SIZE_MB=10

# Frontend origin allowed for CORS (dev)
FRONTEND_ORIGIN=http://localhost:5173

# Device inventory CSV (semicolon-delimited) used by the INVENTORY DeviceProvider
DEVICE_INVENTORY_CSV_PATH=./data/device-inventory.csv

# Set to "true" only when actually served over HTTPS (reverse proxy/VM with a
# real certificate). Leave false/unset for a plain-HTTP LAN demo.
COOKIE_SECURE=false

# Uncomment to have the backend also serve the built frontend from a single
# origin/port (e.g. LAN demo, simple VM, or behind IIS/nginx reverse proxy).
# Run `npm run build` in frontend/ first.
# SERVE_FRONTEND_DIST=../frontend/dist
